// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  name      String?
  googleId  String?  @unique
  githubId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// When this account got its copy of the sample map (once, even if it is deleted later)
  sampleSeededAt DateTime? @map("sample_seeded_at")
  projects  Project[]
}

/// A learner's map. Its title is its root page's title. Ids come from the client.
model Project {
  id          String   @id
  ownerId     String   @map("owner_id")
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  rootPageId  String   @map("root_page_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  pages       Page[]

  @@index([ownerId])
  @@map("projects")
}

/// A page of markdown; pages connect only through [[Title]] links in their content.
model Page {
  id        String
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Order the pages were added in
  position  Int
  title     String
  /// lower(trim(title)), or null while the page has no title: keeps titles unique per map
  titleKey  String?  @map("title_key")
  content   String   @default("")
  studied   Boolean  @default(false)
  module    Boolean?
  color     String?
  icon      String?
  /// Last edit to the title or the text
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  @@id([projectId, id])
  @@unique([projectId, titleKey])
  @@map("pages")
}
