# Copy to apps/api/.env to run the API outside Docker.
# docker compose sets these itself; this file is only for `pnpm --filter @wisepath/api dev`.

# Postgres from `docker compose up -d db`
DATABASE_URL="postgresql://wisepath:wisepath@localhost:5432/wisepath"

# Any long random string; never reuse the example in production
JWT_SECRET="local-dev-only-change-me"

# Where the web app runs (CORS)
FRONTEND_URL="http://localhost:3002"

# Optional: OAuth (not wired in the web app yet)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
