{
  "name": "@wisepath/api",
  "version": "1.0.0",
  "private": true,
  "prisma": {
    "schema": "../../prisma/schema.prisma",
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/sql-pg": "4.0.3",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@wisepath/contract": "workspace:^",
    "@wisepath/domain": "workspace:^",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "effect": "4.0.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.3",
    "@nestjs/cli": "^10.0.0",
    "@prisma/client": "^5.11.0",
    "@swc/core": "^1.16.18",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "prisma": "^5.11.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.3.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "5.0.4",
    "webpack-node-externals": "^3.0.0"
  }
}
